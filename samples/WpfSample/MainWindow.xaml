<Window x:Class="MediaEmbedKit.Mpv.Samples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:MediaEmbedKit.Mpv.Wpf;assembly=MediaEmbedKit.Mpv.Wpf"
        Title="MediaEmbedKit.Mpv WPF Sample"
        Width="1200"
        Height="720"
        MinWidth="1200"
        MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="168" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UrlTextBox"
                     Height="32"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     Text="https://www.youtube.com/watch?v=dQw4w9WgXcQ" />
            <Button Grid.Column="1"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Load"
                    Click="LoadClick" />
            <Button Grid.Column="2"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Pause"
                    Click="PauseClick" />
            <Button Grid.Column="3"
                    Width="88"
                    Height="32"
                    Content="Stop"
                    Click="StopClick" />
        </Grid>

        <Grid x:Name="FeaturePanelHost"
              Grid.Row="1"
              Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="8,4,8,0"
                       VerticalAlignment="Center">
                <ComboBox x:Name="FormatComboBox"
                          Width="132"
                          Height="32"
                          Margin="0,0,8,0"
                          SelectionChanged="FormatComboBoxSelectionChanged" />
                <TextBlock x:Name="StatusTextBlock"
                           Width="380"
                           Height="32"
                           Margin="0,0,8,0"
                           Padding="8,0"
                           VerticalAlignment="Center"
                           Text="播放器尚未初始化"
                           TextTrimming="CharacterEllipsis" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="OSD"
                        Click="OsdClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="-10s"
                        Click="SeekBackwardClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="+10s"
                        Click="SeekForwardClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Vol-"
                        Click="VolumeDownClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Vol+"
                        Click="VolumeUpClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Mute"
                        Click="MuteClick" />
                <Button Width="76"
                        Height="32"
                        Content="Speed"
                        Click="SpeedClick" />
            </WrapPanel>

            <WrapPanel Grid.Row="1"
                       Margin="8,2,8,4"
                       VerticalAlignment="Center">
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Sub"
                        Click="SubtitleClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Tracks"
                        Click="TracksClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Shot"
                        Click="ScreenshotClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Config"
                        Click="ConfigClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Lua"
                        Click="LuaClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="yt-dlp"
                        Click="YtdlpClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Deno"
                        Click="DenoClick" />
                <Button Width="76"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="FFmpeg"
                        Click="FFmpegClick" />
                <Button Width="100"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Save as MP4"
                        Click="SaveAsMp4Click" />
                <Button Width="88"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Update yt"
                        Click="YtdlpUpdateClick" />
                <Button Width="120"
                        Height="32"
                        Content="Update Deno"
                        Click="DenoUpdateClick" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2"
                Margin="8,4,8,4"
                Padding="8,0"
                Background="#11000000"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="MVVM 綁定示範：" />
                <TextBlock Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           Text="狀態 =" />
                <TextBlock Width="80"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           Text="{Binding PlaybackState, FallbackValue=Idle}" />
                <TextBlock Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           Text="音量" />
                <Slider Width="160"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="130"
                        Value="{Binding Volume, Mode=TwoWay, FallbackValue=100}" />
                <Button Width="120"
                        Height="28"
                        Margin="12,0,0,0"
                        Content="Toggle Pause"
                        Command="{Binding TogglePauseCommand}" />
                <Button Width="120"
                        Height="28"
                        Margin="8,0,0,0"
                        Content="Toggle Mute"
                        Command="{Binding ToggleMuteCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3"
              Background="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="16,6,8,6"
                        Background="#DD0078D4"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="控制項 OverlayContent：可覆蓋 HWND" />
                </Border>

                <Border Grid.Column="1"
                        Margin="8,6,16,6"
                        Background="#DD5C2D91"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="一般 WPF Overlay 嘗試覆蓋同一個 HWND" />
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  ClipToBounds="True"
                  Background="Black">
                <Grid x:Name="PlayerHostContainer" />

                <Border Width="340"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="16"
                        Background="#DD5C2D91"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="一般 WPF Overlay：AirSpace 對照" />
                </Border>
            </Grid>
        </Grid>

        <ListBox x:Name="EventListBox"
                 Grid.Row="4"
                 Margin="0"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
