<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WindowsAppSDK SelfContained 要求 singular RID。預設為 host architecture，
         可透過 `dotnet publish -r win-arm64` 或環境變數覆寫。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <AssemblyName>MediaEmbedKit.Mpv.Samples.Maui</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Samples.Maui</RootNamespace>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>MediaEmbedKit.Mpv MAUI Sample</ApplicationTitle>
    <ApplicationId>dev.mediaembedkit.mpv.samples.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon：背景單色 + 前景 play triangle，由 MAUI build 自動產生各平台所需解析度。 -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F4A4F" />

    <!-- Splash screen：與 app icon 同 play triangle 主題；底色對齊 icon 背景。 -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F4A4F" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SampleRuntime.cs" Link="SampleRuntime.cs" />
    <Compile Include="..\SampleEventLogDispatcher.cs" Link="SampleEventLogDispatcher.cs" />
    <Compile Include="..\SampleStatusUpdateDispatcher.cs" Link="SampleStatusUpdateDispatcher.cs" />
    <Compile Include="..\SamplePlayerEventBridge.cs" Link="SamplePlayerEventBridge.cs" />
    <Compile Include="..\SampleFeatureController.cs" Link="SampleFeatureController.cs" />
    <Compile Include="..\SampleEncodingHelper.cs" Link="SampleEncodingHelper.cs" />
    <Compile Include="..\SampleAsyncFeatureGate.cs" Link="SampleAsyncFeatureGate.cs" />
    <Compile Include="..\SampleTheme.cs" Link="SampleTheme.cs" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="..\..\src\MediaEmbedKit.Mpv.Maui\MediaEmbedKit.Mpv.Maui.csproj" />
  </ItemGroup>
</Project>
