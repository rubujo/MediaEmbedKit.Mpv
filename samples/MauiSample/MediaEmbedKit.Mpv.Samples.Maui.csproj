<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <AssemblyName>MediaEmbedKit.Mpv.Samples.Maui</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Samples.Maui</RootNamespace>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>MediaEmbedKit.Mpv MAUI Sample</ApplicationTitle>
    <ApplicationId>dev.mediaembedkit.mpv.samples.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SampleRuntime.cs" Link="SampleRuntime.cs" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="..\..\src\MediaEmbedKit.Mpv.Maui\MediaEmbedKit.Mpv.Maui.csproj" />
  </ItemGroup>
</Project>
