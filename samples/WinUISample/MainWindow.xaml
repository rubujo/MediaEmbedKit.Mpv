<Window
    x:Class="MediaEmbedKit.Mpv.Samples.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mpv="using:MediaEmbedKit.Mpv.WinUI"
    Title="MediaEmbedKit.Mpv WinUI 3 Sample">
    <Grid RowDefinitions="48,Auto,40,*,168">
        <Grid ColumnDefinitions="*,96,96,88" Padding="8">
            <TextBox x:Name="SourceBox"
                     Text="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                     Height="32"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Load"
                    Click="OnLoadClicked" />
            <Button Grid.Column="2"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Pause"
                    Click="OnPauseClicked" />
            <Button Grid.Column="3"
                    Width="88"
                    Height="32"
                    Content="Stop"
                    Click="OnStopClicked" />
        </Grid>

        <Grid x:Name="FeaturePanelHost"
              Grid.Row="1"
              RowDefinitions="Auto,Auto"
              Padding="8,4,8,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="FormatComboBox"
                              Width="132"
                              Height="32"
                              SelectionChanged="OnFormatSelectionChanged" />
                    <Border Width="380"
                            Height="32">
                        <TextBlock x:Name="StatusTextBlock"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Text="播放器尚未初始化"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Width="76"
                            Height="32"
                            Content="OSD"
                            Click="OnOsdClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="-10s"
                            Click="OnSeekBackwardClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="+10s"
                            Click="OnSeekForwardClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Vol-"
                            Click="OnVolumeDownClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Vol+"
                            Click="OnVolumeUpClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Mute"
                            Click="OnMuteClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Speed"
                            Click="OnSpeedClicked" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1"
                          Margin="0,6,0,0"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Width="76"
                            Height="32"
                            Content="Sub"
                            Click="OnSubtitleClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Tracks"
                            Click="OnTracksClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Shot"
                            Click="OnScreenshotClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Config"
                            Click="OnConfigClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Lua"
                            Click="OnLuaClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="yt-dlp"
                            Click="OnYtdlpClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="Deno"
                            Click="OnDenoClicked" />
                    <Button Width="76"
                            Height="32"
                            Content="FFmpeg"
                            Click="OnFFmpegClicked" />
                    <Button Width="100"
                            Height="32"
                            Content="Save MP4"
                            Click="OnSaveMp4Clicked" />
                    <Button Width="88"
                            Height="32"
                            Content="Update yt"
                            Click="OnYtdlpUpdateClicked" />
                    <Button Width="120"
                            Height="32"
                            Content="Update Deno"
                            Click="OnDenoUpdateClicked" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="MvvmDemoBar"
                Grid.Row="2"
                Margin="8,4,8,4"
                Padding="8,0"
                Background="#11000000"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="MVVM 綁定示範：" />
                <TextBlock VerticalAlignment="Center"
                           Text="狀態 =" />
                <TextBlock Width="80"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           Text="{Binding PlaybackState, FallbackValue=Idle}" />
                <TextBlock VerticalAlignment="Center"
                           Text="音量" />
                <Slider Width="160"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="130"
                        Value="{Binding Volume, Mode=TwoWay, FallbackValue=100}" />
                <Button Width="120"
                        Height="28"
                        Content="Toggle Pause"
                        Command="{Binding TogglePauseCommand}" />
                <Button Width="120"
                        Height="28"
                        Content="Toggle Mute"
                        Command="{Binding ToggleMuteCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" RowDefinitions="40,*" Background="Black">
            <Grid ColumnDefinitions="*,*">
                <Border Margin="16,6,8,6"
                        Background="#DD0078D4"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="控制項 OverlayContent：可覆蓋 HWND" />
                </Border>

                <Border Grid.Column="1"
                        Margin="8,6,16,6"
                        Background="#DD5C2D91"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="一般 WinUI Overlay 嘗試覆蓋同一個 HWND" />
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Background="Black">
                <Grid x:Name="PlayerHostContainer" />

                <Border Width="340"
                        Height="32"
                        Margin="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#DD5C2D91"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="一般 WinUI Overlay：AirSpace 對照" />
                </Border>
            </Grid>
        </Grid>

        <ListView x:Name="EventList"
                  Grid.Row="4"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="Consolas"
                               FontSize="12" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
