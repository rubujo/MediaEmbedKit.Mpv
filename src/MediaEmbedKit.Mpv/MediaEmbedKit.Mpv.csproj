<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv</RootNamespace>
    <Description>供 Windows 桌面控制項使用的受控 libmpv 包裝函式庫。</Description>
    <PackageId>MediaEmbedKit.Mpv</PackageId>
    <Title>MediaEmbedKit.Mpv</Title>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!--
      LibraryImport source generator 會產生含 unsafe block 的 marshalling 程式碼
      （SYSLIB1062）；net7.0+ 走 LibraryImport 路徑時必須啟用。其他 TFM 仍走
      DllImport，不需要 unsafe。
    -->
    <!-- AllowUnsafeBlocks 已提升為全域設定 -->
    <!--
      66 / 66 P/Invoke 已透過 LibraryImport source generator 產生 marshalling，
      MpvNodeMarshaller 等內部反射路徑已避免使用 type-name 反射；本核心套件對
      trimming 與 NativeAOT 友善。使用端 (NativeAOT app / trim-published app)
      可信賴本套件不會在 trim/AOT 後消失關鍵成員。
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
