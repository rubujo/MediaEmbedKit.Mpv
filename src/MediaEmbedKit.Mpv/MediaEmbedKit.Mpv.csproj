<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv</RootNamespace>
    <Description>Managed libmpv wrapper for Windows desktop controls.</Description>
    <PackageId>MediaEmbedKit.Mpv</PackageId>
    <Title>MediaEmbedKit.Mpv</Title>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
