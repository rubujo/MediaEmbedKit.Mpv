<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv.Encoding</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv</RootNamespace>
    <Description>High-level encoding facade for libmpv (MpvEncoder) — single/two-pass encode, stream-copy, frame extraction, EDL concat, multi-segment split with progress reporting and cancellation support.</Description>
    <PackageId>MediaEmbedKit.Mpv.Encoding</PackageId>
    <Title>MediaEmbedKit.Mpv.Encoding</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaEmbedKit.Mpv\MediaEmbedKit.Mpv.csproj" />
  </ItemGroup>
</Project>
