<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>MediaEmbedKit.Mpv.Maui.Windows</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Maui.Windows</RootNamespace>
    <Description>MediaEmbedKit.Mpv 的 .NET MAUI Windows handler，僅支援 Windows（net10.0-windows10.0.19041.0）並橋接至 MpvWinUiPlayer；Windows 以外的跨平台 .NET MAUI 不提供實際播放支援。</Description>
    <PackageId>MediaEmbedKit.Mpv.Maui.Windows</PackageId>
    <Title>MediaEmbedKit.Mpv.Maui.Windows</Title>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="..\MediaEmbedKit.Mpv\MediaEmbedKit.Mpv.csproj" />
    <ProjectReference Include="..\MediaEmbedKit.Mpv.WinUI\MediaEmbedKit.Mpv.WinUI.csproj" />
  </ItemGroup>
</Project>
