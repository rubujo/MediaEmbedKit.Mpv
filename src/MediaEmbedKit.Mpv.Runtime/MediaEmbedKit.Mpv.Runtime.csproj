<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv.Runtime</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Downloads</RootNamespace>
    <Description>libmpv Windows runtime installer — auto-download, idempotent install with sidecar marker, cross-process file lock, 4-tier archive extraction fallback.</Description>
    <PackageId>MediaEmbedKit.Mpv.Runtime</PackageId>
    <Title>MediaEmbedKit.Mpv.Runtime</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaEmbedKit.Mpv\MediaEmbedKit.Mpv.csproj" />
    <ProjectReference Include="..\MediaEmbedKit.Mpv.Externals\MediaEmbedKit.Mpv.Externals.csproj" />
  </ItemGroup>
</Project>
