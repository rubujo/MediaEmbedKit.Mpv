<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv.Diagnostics</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Downloads</RootNamespace>
    <Description>供 libmpv 執行階段使用的授權稽核（LGPL / GPL / NonFree 分類）、執行階段健檢與函式庫更新排程器（暫存更新與回復）。</Description>
    <PackageId>MediaEmbedKit.Mpv.Diagnostics</PackageId>
    <Title>MediaEmbedKit.Mpv.Diagnostics</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaEmbedKit.Mpv\MediaEmbedKit.Mpv.csproj" />
    <ProjectReference Include="..\MediaEmbedKit.Mpv.Externals\MediaEmbedKit.Mpv.Externals.csproj" />
    <ProjectReference Include="..\MediaEmbedKit.Mpv.Runtime\MediaEmbedKit.Mpv.Runtime.csproj" />
  </ItemGroup>
</Project>
