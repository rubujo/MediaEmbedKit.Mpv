<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net48;net10.0</TargetFrameworks>
    <AssemblyName>MediaEmbedKit.Mpv.Hosting</AssemblyName>
    <RootNamespace>MediaEmbedKit.Mpv.Hosting</RootNamespace>
    <Description>MediaEmbedKit.Mpv 的 Microsoft.Extensions.DependencyInjection 整合，提供 IMpvPlayerFactory 與 AddMpvPlayerFactory 輔助方法。</Description>
    <PackageId>MediaEmbedKit.Mpv.Hosting</PackageId>
    <Title>MediaEmbedKit.Mpv.Hosting</Title>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaEmbedKit.Mpv\MediaEmbedKit.Mpv.csproj" />
  </ItemGroup>
</Project>
